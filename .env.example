# Required for POST /chat
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_MAX_OUTPUT_TOKENS=4096
APP_TIMEZONE=Asia/Bangkok

# Required when /chat must read ERP data; use a read-only MongoDB user
MONGODB_URI=mongodb://readonly_user:password@localhost:27017/?authSource=admin
MONGODB_DATABASE=ev_rental_erp

# Optional override for scripts/seed_mock_data.py.
# Leave blank to seed with MONGODB_URI in MONGODB_DATABASE only.
MONGODB_SEED_URI=

# Optional safety/runtime settings (defaults shown)
MAX_AGENT_RETRY=3
MAX_QUERY_LIMIT=100
MONGO_TIMEOUT_MS=5000

# Optional development debug settings (defaults shown)
DEBUG_AGENT=true
DEBUG_LEVEL=full
PRINT_ANSWER_TO_CONSOLE=true
TRACE_DIR=.debug_traces
